{
  "name": "autostudio",
  "productName": "AutoStudio",
  "version": "0.1.0",
  "description": "AutoStudio \u2014 a building information modeling (BIM) app for macOS.",
  "author": "AutoStudio",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test test/*.test.js",
    "dist": "vite build && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:dir": "vite build && electron-builder --dir --publish never"
  },
  "build": {
    "appId": "com.autostudio.bim",
    "productName": "AutoStudio",
    "copyright": "Copyright \u00a9 2026 AutoStudio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "asbim",
        "name": "AutoStudio Project",
        "role": "Editor"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "AutoStudio ${version}",
      "artifactName": "AutoStudio-${version}-${arch}.dmg"
    }
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "three": "0.186.1",
    "vite": "8.3.4"
  }
}
